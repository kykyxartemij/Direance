// ─────────────────────────────────────────────────────────────────
//  FieldMapping — rules for normalising source field names
//  isGlobal = visible to all users (e.g. built-in Merit.ee mapping)
//  userId   = null for global mappings
// ─────────────────────────────────────────────────────────────────

// Shared with Connection.reportType — which report a mapping/connection produces.
enum ReportType {
  pnl
  financial_position
}

model FieldMapping {
  id         String     @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  isGlobal   Boolean    @default(false)
  reportType ReportType @default(pnl)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// [MappingConfig]
  config Json @default("{}")

  exportSettingId String?
  exportSetting   ExportSetting? @relation(fields: [exportSettingId], references: [id], onDelete: SetNull)

  // Back-reference required by Prisma — never selected; Connection owns the FK
  connections Connection[]

  search_vector Unsupported("tsvector")? // managed by fts.sql trigger

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
}
