DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
PORT=3317

# Email — Gmail SMTP. Unset = sending an invite fails.
# Gmail app password, not the account password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Encrypts stored connection secrets — changing it makes every saved connection undecryptable
CONNECTION_SECRET_KEY=

# Vercel Cron auth — /api/cron/cleanup 401s without it, so the daily cleanup silently stops
CRON_SECRET=

# Neon DB monitoring — console.neon.tech → Account Settings → API Keys
# NEON_ORG_ID: visible in console URL, e.g. org-polished-resonance-30045051
NEON_API_KEY=
# Project ID: visible in Neon console URL or Settings → General
NEON_PROJECT_ID=

# Transfer + compute plan limits (free tier defaults; storage limit comes from Neon API automatically)
NEON_TRANSFER_LIMIT_BYTES=5368709120
NEON_COMPUTE_LIMIT_CU_HOURS=100
